# Database
DB_URL=jdbc:postgresql://your-host:5432/your-db
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# Gmail SMTP
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Stripe
STRIPE_API_KEY=sk_test_or_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# JWT
JWT_SECRET=your-base64-encoded-secret

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# Frontend URL (used in email links)
APP_BASE_URL=http://localhost:5173

# Google Calendar sync (optional — booking flow works fine if left blank,
# events just won't be created). GOOGLE_CALENDAR_ID is the calendar to
# write to (e.g. Everett's Gmail address, after he's shared "Make changes
# to events" access with the service account below). GOOGLE_CALENDAR_CREDENTIALS_JSON
# is the *entire contents* of the service account's downloaded JSON key file,
# pasted as one line.
GOOGLE_CALENDAR_ID=everettleefitness@gmail.com
GOOGLE_CALENDAR_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}
